# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Google OAuth Credentials (for Gmail, Calendar, Sheets, Drive)
# You can obtain these from the Google Cloud Console (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_PORT=8080

# Application Configuration
DATABASE_PATH=assistant.db
# Timezone for scheduled briefings (e.g. UTC, US/Eastern, Asia/Kolkata)
DEFAULT_TIMEZONE=Asia/Kolkata
